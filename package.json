{
  "name": "acurist",
  "version": "1.2.4",
  "description": "Claude-Code-style terminal agent UI for the Acurist local proxy",
  "type": "module",
  "author": "IMApurbo",
  "license": "MIT",
  "keywords": [
    "cli",
    "ai",
    "agent",
    "terminal",
    "acurist"
  ],
  "bin": {
    "acurist": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p . && chmod +x dist/index.js",
    "dev": "tsc -p . --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "postbuild": "cp src/core/sha3_wasm_bg.wasm dist/ && mkdir -p dist/core && cp src/core/sha3_wasm_bg.wasm dist/core/"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.0",
    "node-fetch": "^3.3.2",
    "chalk": "^5.3.0",
    "conf": "^12.0.0",
    "marked": "^12.0.1",
    "marked-terminal": "^7.0.0",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
